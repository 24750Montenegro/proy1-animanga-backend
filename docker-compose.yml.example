version: '3.8'

services:
  db:
    image: postgres:16-alpine
    container_name: animanga_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: animanga
      POSTGRES_PASSWORD: animanga123
      POSTGRES_DB: animanga_db
    ports:
      - "${DB_PORT}:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  backend:
    build: .
    container_name: animanga_backend
    restart: unless-stopped
    ports:
      - "${PORT}:3000"
    environment:
      DB_HOST: db
      DB_PORT: 5432
      DB_USER: animanga
      DB_PASSWORD: animanga123
      DB_NAME: animanga_db
    depends_on:
      - db
    volumes:
      - .:/app
      - /app/node_modules

volumes:
  pgdata:
